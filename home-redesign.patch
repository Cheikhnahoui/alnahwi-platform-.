+# Copy to .env.local (read by Next.js) and to .env (read by the db:* and admin:create scripts).
+# Never commit real values: .env and .env.local are git-ignored. Do not put secrets in this file.
+
+# PostgreSQL connection string. Required.
+# Local example:   postgres://USER:PASSWORD@localhost:5432/DATABASE
+# Supabase + Vercel: see "Deploying with Supabase + Vercel" in README.md
+#   (Transaction pooler, port 6543, on Vercel; Session pooler, port 5432, for db:migrate / db:seed).
+DATABASE_URL=
+
+# Public URL of the site, used for absolute links and metadata. Defaults to http://localhost:3000.
+NEXT_PUBLIC_SITE_URL=http://localhost:3000
+
+# Secret that protects admin sessions. Required, at least 32 characters, different per environment.
+# Generate one with:  openssl rand -base64 48
+AUTH_SECRET=
+
+# Optional, for automation only: password read by `npm run admin:create` when there is no
+# interactive terminal. Leave it unset normally; the script prompts for the password instead.
+# ADMIN_PASSWORD=
