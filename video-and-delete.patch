diff --git a/tests/content-delete.test.ts b/tests/content-delete.test.ts
new file mode 100644
index 0000000..8795f29
--- /dev/null
+++ b/tests/content-delete.test.ts
@@ -0,0 +1,179 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { eq } from "drizzle-orm";
+import { createTestDb } from "./helpers/db";
+import { seedReferenceData } from "@/lib/db/seed-reference";
+import * as s from "@/lib/db/schema";
+import { ROLES, type RoleKey } from "@/lib/auth/permissions";
+import { getContentBySlug, listContent } from "@/lib/content/queries";
+import type { ContentData } from "@/lib/admin/content-input";
+import {
+  PermissionError,
+  WorkflowError,
+  createContent,
+  deleteContent,
+  transition,
+  type Actor,
+} from "@/lib/admin/content";
+
+let ctx: Awaited<ReturnType<typeof createTestDb>>;
+let typeId: string;
+let catId: string;
+const actors = {} as Record<RoleKey, Actor>;
+
+const data = (over: Partial<ContentData> = {}): ContentData => ({
+  title: "مادة للحذف",
+  contentTypeId: typeId,
+  summary: null,
+  description: null,
+  speakerName: null,
+  recordedAt: null,
+  durationSeconds: null,
+  thumbnailUrl: null,
+  copyrightNotice: null,
+  permissionStatus: "unknown",
+  reuseRestrictions: null,
+  isFeatured: false,
+  categoryIds: [],
+  tags: [],
+  relatedSlugs: [],
+  sources: [],
+  ...over,
+});
+
+beforeAll(async () => {
+  ctx = await createTestDb();
+  await seedReferenceData(ctx.db);
+  typeId = (await ctx.db.select().from(s.contentTypes))[0].id;
+  for (const key of Object.keys(ROLES) as RoleKey[]) {
+    const [role] = await ctx.db.select().from(s.roles).where(eq(s.roles.key, key));
+    const [u] = await ctx.db
+      .insert(s.users)
+      .values({ email: `${key}@example.org`, name: key, roleId: role.id })
+      .returning({ id: s.users.id });
+    actors[key] = { id: u.id, permissions: ROLES[key].permissions };
+  }
+  catId = (await ctx.db.insert(s.categories).values({ slug: "c", name: "تصنيف" }).returning())[0]
+    .id;
+});
+afterAll(async () => ctx.client.close());
+
+async function publishedItem(title: string, over: Partial<ContentData> = {}) {
+  const row = await createContent(ctx.db, actors.super_admin, data({ title, ...over }));
+  await transition(ctx.db, actors.super_admin, row.id, "publish");
+  return row;
+}
+
+describe("permanent deletion", () => {
+  it("removes a PUBLISHED item and its page disappears from the public site", async () => {
+    const row = await publishedItem("منشورة", {
+      categoryIds: [catId],
+      tags: ["وسم"],
+      sources: [
+        {
+          kind: "video",
+          url: "https://youtu.be/dQw4w9WgXcQ",
+          sourceName: "قناة",
+          isPrimary: true,
+          isDownloadable: false,
+        },
+      ],
+    });
+    expect(await getContentBySlug(ctx.db, row.slug)).not.toBeNull();
+    const before = (await listContent(ctx.db, { pageSize: 100 })).total;
+
+    await deleteContent(ctx.db, actors.super_admin, row.id);
+
+    expect(await getContentBySlug(ctx.db, row.slug)).toBeNull();
+    expect((await listContent(ctx.db, { pageSize: 100 })).total).toBe(before - 1);
+    expect(await ctx.db.select().from(s.contentItems).where(eq(s.contentItems.id, row.id))).toEqual(
+      [],
+    );
+  });
+
+  it("takes its sources and category/tag links with it, but keeps categories and tags", async () => {
+    const row = await publishedItem("روابط", {
+      categoryIds: [catId],
+      tags: ["باقٍ"],
+      sources: [
+        {
+          kind: "video",
+          url: "https://youtu.be/dQw4w9WgXcQ",
+          sourceName: null,
+          isPrimary: true,
+          isDownloadable: false,
+        },
+      ],
+    });
+    await deleteContent(ctx.db, actors.super_admin, row.id);
+    expect(
+      await ctx.db
+        .select()
+        .from(s.contentSources)
+        .where(eq(s.contentSources.contentItemId, row.id)),
+    ).toEqual([]);
+    expect(
+      await ctx.db
+        .select()
+        .from(s.contentCategories)
+        .where(eq(s.contentCategories.contentItemId, row.id)),
+    ).toEqual([]);
+    expect(
+      await ctx.db.select().from(s.contentTags).where(eq(s.contentTags.contentItemId, row.id)),
+    ).toEqual([]);
+    expect((await ctx.db.select().from(s.categories)).length).toBeGreaterThan(0);
+    expect((await ctx.db.select().from(s.tags)).some((t) => t.name === "باقٍ")).toBe(true);
+  });
+
+  it("leaves other items (and links pointing at them) intact", async () => {
+    const keep = await publishedItem("باقية");
+    const gone = await publishedItem("محذوفة", { relatedSlugs: [keep.slug] });
+    await deleteContent(ctx.db, actors.super_admin, gone.id);
+    const still = await getContentBySlug(ctx.db, keep.slug);
+    expect(still?.title).toBe("باقية");
+  });
+
+  it("works for drafts and archived items too", async () => {
+    const draft = await createContent(ctx.db, actors.super_admin, data({ title: "مسودة" }));
+    await deleteContent(ctx.db, actors.super_admin, draft.id);
+    const arch = await publishedItem("مؤرشفة");
+    await transition(ctx.db, actors.super_admin, arch.id, "archive");
+    await deleteContent(ctx.db, actors.super_admin, arch.id);
+    expect(
+      await ctx.db.select().from(s.contentItems).where(eq(s.contentItems.id, arch.id)),
+    ).toEqual([]);
+  });
+
+  it("writes an audit entry with the title and no sensitive data", async () => {
+    const row = await publishedItem("سجل الحذف");
+    await deleteContent(ctx.db, actors.super_admin, row.id);
+    const [log] = await ctx.db.select().from(s.auditLogs).where(eq(s.auditLogs.entityId, row.id));
+    const entries = (
+      await ctx.db.select().from(s.auditLogs).where(eq(s.auditLogs.entityId, row.id))
+    ).filter((l) => l.action === "content.delete");
+    expect(log).toBeDefined();
+    expect(entries).toHaveLength(1);
+    expect(entries[0].actorId).toBe(actors.super_admin.id);
+    expect(entries[0].metadata).toEqual({ title: "سجل الحذف", slug: row.slug, state: "published" });
+  });
+
+  it("is refused for everyone except the main administrator, and nothing is deleted", async () => {
+    const row = await publishedItem("محمية");
+    for (const key of ["content_manager", "editor", "reviewer"] as const) {
+      await expect(deleteContent(ctx.db, actors[key], row.id), key).rejects.toBeInstanceOf(
+        PermissionError,
+      );
+    }
+    expect(await getContentBySlug(ctx.db, row.slug)).not.toBeNull();
+  });
+
+  it("reports a missing item clearly, and a second delete does nothing", async () => {
+    const row = await publishedItem("مرتين");
+    await deleteContent(ctx.db, actors.super_admin, row.id);
+    await expect(deleteContent(ctx.db, actors.super_admin, row.id)).rejects.toBeInstanceOf(
+      WorkflowError,
+    );
+    await expect(
+      deleteContent(ctx.db, actors.super_admin, "00000000-0000-4000-8000-000000000000"),
+    ).rejects.toBeInstanceOf(WorkflowError);
+  });
+});
diff --git a/tests/media.test.ts b/tests/media.test.ts
new file mode 100644
index 0000000..4548392
--- /dev/null
+++ b/tests/media.test.ts
@@ -0,0 +1,120 @@
+import { describe, expect, it } from "vitest";
+import { resolvePlayer } from "@/lib/media";
+import { unplayableSourceErrors } from "@/lib/admin/content-input";
+
+const yt = (id: string, qs = "") => ({
+  type: "iframe",
+  provider: "youtube",
+  src: `https://www.youtube-nocookie.com/embed/${id}${qs}`,
+});
+
+describe("resolvePlayer: what can play inside the page", () => {
+  it("understands every common YouTube URL shape", () => {
+    const id = "dQw4w9WgXcQ";
+    for (const url of [
+      `https://www.youtube.com/watch?v=${id}`,
+      `https://youtube.com/watch?v=${id}&list=PL1`,
+      `https://m.youtube.com/watch?v=${id}`,
+      `https://youtu.be/${id}`,
+      `https://www.youtube.com/embed/${id}`,
+      `https://www.youtube.com/shorts/${id}`,
+      `https://www.youtube.com/live/${id}`,
+      `https://www.youtube-nocookie.com/embed/${id}`,
+    ]) {
+      expect(resolvePlayer(url, "video"), url).toEqual(yt(id));
+    }
+  });
+  it("keeps a start time, in seconds", () => {
+    const id = "dQw4w9WgXcQ";
+    expect(resolvePlayer(`https://youtu.be/${id}?t=90`)).toEqual(yt(id, "?start=90"));
+    expect(resolvePlayer(`https://www.youtube.com/watch?v=${id}&t=1m30s`)).toEqual(
+      yt(id, "?start=90"),
+    );
+    expect(resolvePlayer(`https://youtu.be/${id}?t=garbage`)).toEqual(yt(id));
+  });
+  it("understands Vimeo, including unlisted videos with a hash", () => {
+    const base = { type: "iframe", provider: "vimeo" };
+    expect(resolvePlayer("https://vimeo.com/123456789")).toEqual({
+      ...base,
+      src: "https://player.vimeo.com/video/123456789",
+    });
+    expect(resolvePlayer("https://vimeo.com/123456789/abcdef1234")).toEqual({
+      ...base,
+      src: "https://player.vimeo.com/video/123456789?h=abcdef1234",
+    });
+    expect(resolvePlayer("https://player.vimeo.com/video/123456789?h=abcdef1234")).toEqual({
+      ...base,
+      src: "https://player.vimeo.com/video/123456789?h=abcdef1234",
+    });
+  });
+  it("plays direct video and audio files over HTTPS", () => {
+    expect(resolvePlayer("https://cdn.example.org/a/lesson.mp4?token=1", "video")).toEqual({
+      type: "video",
+      src: "https://cdn.example.org/a/lesson.mp4?token=1",
+    });
+    expect(resolvePlayer("https://cdn.example.org/lesson.WEBM")?.type).toBe("video");
+    expect(resolvePlayer("https://cdn.example.org/lesson.mp3", "audio")?.type).toBe("audio");
+    expect(resolvePlayer("https://cdn.example.org/lesson.m4a")?.type).toBe("audio");
+  });
+  it("never embeds anything outside the allow-list", () => {
+    for (const url of [
+      "http://cdn.example.org/lesson.mp4", // plain HTTP: blocked by browsers on an HTTPS page
+      "https://example.org/some-page", // arbitrary page: must stay a link
+      "https://www.youtube.com.evil.example/watch?v=dQw4w9WgXcQ", // look-alike host
+      "https://evil.example/https://www.youtube.com/watch?v=dQw4w9WgXcQ",
+      "https://www.youtube.com/watch?v=short", // not an 11-character id
+      "https://www.youtube.com/watch?v=dQw4w9WgXcQ%22onload%3D", // injection attempt
+      "https://vimeo.com.evil.example/123456789",
+      "javascript:alert(1)",
+      "data:text/html,<script>1</script>",
+      "not a url",
+      "",
+    ]) {
+      expect(resolvePlayer(url, "video"), url).toBeNull();
+    }
+    expect(resolvePlayer(null)).toBeNull();
+  });
+  it("never plays a downloadable file source", () => {
+    expect(resolvePlayer("https://cdn.example.org/lesson.mp4", "file")).toBeNull();
+  });
+});
+
+describe("a source marked video/audio must really play (new or changed links)", () => {
+  const src = (kind: "video" | "audio" | "external_link" | "file", url: string) => ({
+    kind,
+    url,
+    sourceName: null,
+    isPrimary: true,
+    isDownloadable: false,
+  });
+  it("accepts playable video and audio sources", () => {
+    expect(unplayableSourceErrors([src("video", "https://youtu.be/dQw4w9WgXcQ")])).toEqual({});
+    expect(unplayableSourceErrors([src("video", "https://cdn.example.org/a.mp4")])).toEqual({});
+    expect(unplayableSourceErrors([src("audio", "https://cdn.example.org/a.mp3")])).toEqual({});
+  });
+  it("rejects video/audio links that cannot be played, naming the field", () => {
+    const errs = unplayableSourceErrors([
+      src("video", "https://example.org/watch/123"),
+      src("video", "https://youtu.be/dQw4w9WgXcQ"),
+      src("audio", "http://cdn.example.org/a.mp3"),
+    ]);
+    expect(Object.keys(errs)).toEqual(["sources.0.url", "sources.2.url"]);
+    expect(errs["sources.0.url"]).toMatch(/لا يمكن تشغيله/);
+  });
+  it("still allows any https page as a plain link or a file", () => {
+    expect(unplayableSourceErrors([src("external_link", "https://example.org/watch/123")])).toEqual(
+      {},
+    );
+    expect(unplayableSourceErrors([src("file", "https://example.org/book.pdf")])).toEqual({});
+  });
+  it("keeps items saved before this rule editable (same kind and URL already stored)", () => {
+    const old = [{ kind: "video", url: "https://example.org/old-video-page" }];
+    expect(
+      unplayableSourceErrors([src("video", "https://example.org/old-video-page")], old),
+    ).toEqual({});
+    // ...but a NEW unplayable link on the same item is still refused
+    expect(
+      Object.keys(unplayableSourceErrors([src("video", "https://example.org/other")], old)),
+    ).toEqual(["sources.0.url"]);
+  });
+});
