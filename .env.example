# Copy to .env.local (Next.js) and .env (scripts) and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nahwi_site"
#
# Supabase (see README, "Deploying with Supabase"):
#  - On Vercel (the running app) use the TRANSACTION pooler string, port 6543:
#      postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#  - On your own computer, for `npm run db:migrate` / `db:seed`, use the SESSION pooler
#    string (same host, port 5432). The "direct" db.PROJECTREF.supabase.co host is IPv6-only
#    and often unreachable from home networks.
#  - If you get "self-signed certificate in certificate chain", append ?sslmode=no-verify

# Public base URL of the site (used for metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Added in later phases (documented here so deployment is not a surprise) ---
# Phase 4 (auth): a long random secret, e.g. `openssl rand -base64 32`
# AUTH_SECRET=""
# Phase 5 (file storage, S3-compatible)
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""